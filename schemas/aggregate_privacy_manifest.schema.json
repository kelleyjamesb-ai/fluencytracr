{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluencytracr.local/schemas/aggregate_privacy_manifest.schema.json",
  "title": "Aggregate Privacy Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "org_id",
    "workflow_id",
    "jbtd_id",
    "persona_id",
    "privacy_slot_id",
    "content_fingerprint",
    "atomic_lineage_fingerprint",
    "public_projection_hash",
    "temporal_grid_id",
    "window_id",
    "release_version",
    "hierarchy_axis",
    "source_mode",
    "atomic_cell_ids",
    "complete_partition",
    "canonical_contributions",
    "canonical_contribution_fingerprint",
    "canonical_contribution_count",
    "canonical_contribution_ids",
    "has_suppressed_child",
    "has_ambiguous_lineage",
    "has_overlapping_equation",
    "is_multi_window",
    "verified"
  ],
  "properties": {
    "org_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "jbtd_id": { "type": "string", "minLength": 1 },
    "persona_id": { "type": "string", "minLength": 1 },
    "privacy_slot_id": { "type": "string", "minLength": 1 },
    "content_fingerprint": { "type": "string", "minLength": 1 },
    "atomic_lineage_fingerprint": { "type": "string", "minLength": 1 },
    "public_projection_hash": { "type": "string", "minLength": 1 },
    "temporal_grid_id": { "type": "string", "minLength": 1 },
    "window_id": { "type": "string", "minLength": 1 },
    "release_version": { "type": "integer", "minimum": 1 },
    "hierarchy_axis": { "type": "string", "minLength": 1 },
    "source_mode": { "type": "string", "minLength": 1 },
    "atomic_cell_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "complete_partition": { "type": "boolean" },
    "canonical_contributions": { "type": "boolean" },
    "canonical_contribution_fingerprint": { "type": "string", "minLength": 1 },
    "canonical_contribution_count": { "type": "integer", "minimum": 5 },
    "canonical_contribution_ids": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "has_suppressed_child": { "type": "boolean" },
    "has_ambiguous_lineage": { "type": "boolean" },
    "has_overlapping_equation": { "type": "boolean" },
    "is_multi_window": { "type": "boolean" },
    "verified": { "type": "boolean" }
  }
}
