{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluencytracr.local/schemas/outcome_evidence_admission.schema.json",
  "title": "OutcomeEvidenceExactSliceAdmissionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "workflow_id",
    "jbtd_id",
    "persona_id",
    "baseline_window",
    "comparison_window"
  ],
  "properties": {
    "policy_version": {
      "const": "FT_OUTCOME_EVIDENCE_EXACT_SLICE_ADMISSION_2026_07"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:_-]{0,179}$"
    },
    "jbtd_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "baseline_window": {
      "$ref": "#/$defs/admittedWindow"
    },
    "comparison_window": {
      "$ref": "#/$defs/admittedWindow"
    }
  },
  "$defs": {
    "admittedWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_start",
        "period_end",
        "evidence_ids"
      ],
      "properties": {
        "period_start": {
          "type": "string",
          "format": "date-time"
        },
        "period_end": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          }
        }
      }
    }
  }
}
