{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluencytracr.local/schemas/ai-value/canonical-claim-trace.schema.json",
  "title": "Canonical Claim Trace",
  "description": "Internal, read-only Slice F aggregate projection. This schema authorizes no customer-facing output.",
  "oneOf": [{ "$ref": "#/$defs/authorized" }, { "$ref": "#/$defs/held" }],
  "$defs": {
    "positive_version": { "type": "integer", "minimum": 1 },
    "metric_id": { "enum": ["account_health_review_cycle_days", "at_risk_account_share", "customer_health_signal_coverage_share", "cycle_time", "expansion_signal_followup_share", "logo_churn_rate", "qbr_prep_hours_per_account", "renewal_action_staleness_count", "renewal_rate", "risk_review_coverage_share", "sales_forecast_exception_rate", "sales_next_step_completeness_share", "sales_record_update_lag_hours", "sales_stale_opportunity_count", "support_backlog_count", "support_escalation_rate", "support_first_contact_resolution_rate", "support_median_resolution_hours", "support_reopen_rate", "support_verification_coverage"] },
    "measurement_unit": { "enum": ["cases", "count", "days", "hours", "minutes", "months", "percent", "percentage_points", "rate", "ratio", "seconds", "share", "weeks"] },
    "approved_direction": { "enum": ["INCREASE", "DECREASE", "MAINTAIN", "MONITOR", "NO_CHANGE"] },
    "movement": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "measurement_unit", "baseline_value", "comparison_value", "absolute_delta", "observed_direction", "claim_label"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/metric_id" }, "measurement_unit": { "$ref": "#/$defs/measurement_unit" },
        "baseline_value": { "type": "number" }, "comparison_value": { "type": "number" }, "absolute_delta": { "type": "number" }, "percent_change": { "type": "number" },
        "observed_direction": { "enum": ["INCREASE", "DECREASE", "NO_CHANGE"] }, "approved_metric_direction": { "$ref": "#/$defs/approved_direction" }, "claim_label": { "const": "OBSERVED_NON_ATTRIBUTABLE" }
      }
    },
    "caveats": { "type": "array", "prefixItems": [{ "const": "Aggregate observation only." }, { "const": "No attribution to AI or any intervention." }, { "const": "No causal conclusion." }, { "const": "Internal review only; not customer-facing." }], "items": false, "minItems": 4, "maxItems": 4 },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_schema_state", "evidence_review_state", "evidence_admission_state", "comparison_privacy_state", "readiness_state", "model_eligibility_state", "model_use_authorized", "claim_authorization_state", "customer_facing_output_authorized"],
      "properties": {
        "evidence_schema_state": { "const": "VALID" }, "evidence_review_state": { "const": "ACCEPTED" }, "evidence_admission_state": { "const": "ADMITTED" }, "comparison_privacy_state": { "const": "ATOMIC_COMPARISON_PRIVACY_RELEASED" }, "readiness_state": { "const": "INTERNAL_CLAIM_REVIEW_PERMITTED" }, "model_eligibility_state": { "const": "NOT_REQUESTED" }, "model_use_authorized": { "const": false }, "claim_authorization_state": { "const": "AUTHORIZED" }, "customer_facing_output_authorized": { "const": false }
      }
    },
    "authorized": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "trace_state", "source_bound", "read_only", "customer_facing_output_authorized", "stages"],
      "properties": {
        "schema_version": { "const": "FT_CANONICAL_CLAIM_TRACE_V1" }, "trace_state": { "const": "AUTHORIZED" }, "source_bound": { "const": true }, "read_only": { "const": true }, "customer_facing_output_authorized": { "const": false },
        "stages": {
          "type": "object", "additionalProperties": false,
          "required": ["hypothesis", "measurement", "evidence", "policy", "claim", "readout"],
          "properties": {
            "hypothesis": { "type": "object", "additionalProperties": false, "required": ["approval_state", "version"], "properties": { "approval_state": { "const": "APPROVED" }, "version": { "$ref": "#/$defs/positive_version" } } },
            "measurement": { "type": "object", "additionalProperties": false, "required": ["approval_state", "plan_version", "cell_version", "metric_id", "measurement_unit", "approved_direction", "aggregate_only"], "properties": { "approval_state": { "const": "APPROVED" }, "plan_version": { "$ref": "#/$defs/positive_version" }, "cell_version": { "$ref": "#/$defs/positive_version" }, "metric_id": { "$ref": "#/$defs/metric_id" }, "measurement_unit": { "$ref": "#/$defs/measurement_unit" }, "approved_direction": { "$ref": "#/$defs/approved_direction" }, "aggregate_only": { "const": true } } },
            "evidence": { "type": "object", "additionalProperties": false, "required": ["schema_state", "review_state", "admission_state", "comparison_privacy_state"], "properties": { "schema_state": { "const": "VALID" }, "review_state": { "const": "ACCEPTED" }, "admission_state": { "const": "ADMITTED" }, "comparison_privacy_state": { "const": "ATOMIC_COMPARISON_PRIVACY_RELEASED" } } },
            "policy": { "$ref": "#/$defs/policy" },
            "claim": { "type": "object", "additionalProperties": false, "required": ["movement", "caveats"], "properties": { "movement": { "$ref": "#/$defs/movement" }, "caveats": { "$ref": "#/$defs/caveats" } } },
            "readout": { "type": "object", "additionalProperties": false, "required": ["canonical_identity_state", "current_state", "source_bound", "mutation_authorized", "export_authorized", "customer_facing_output_authorized"], "properties": { "canonical_identity_state": { "const": "BOUND" }, "current_state": { "const": "CURRENT" }, "source_bound": { "const": true }, "mutation_authorized": { "const": false }, "export_authorized": { "const": false }, "customer_facing_output_authorized": { "const": false } } }
          }
        }
      }
    },
    "held": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "trace_state", "source_bound", "read_only", "canonical_identity_state", "customer_facing_output_authorized"],
      "properties": { "schema_version": { "const": "FT_CANONICAL_CLAIM_TRACE_V1" }, "trace_state": { "const": "HOLD" }, "source_bound": { "const": false }, "read_only": { "const": true }, "canonical_identity_state": { "const": "UNBOUND" }, "customer_facing_output_authorized": { "const": false } }
    }
  }
}
