# Local Docker Postgres from infra/docker-compose.yml.
# Prisma requires both DATABASE_URL and DIRECT_URL. For local development they
# can point at the same database.
DATABASE_URL="postgresql://fluency:fluency@localhost:5432/fluency?schema=public"
DIRECT_URL="postgresql://fluency:fluency@localhost:5432/fluency?schema=public"

# Supabase alternative:
# - DATABASE_URL should use the pooled connection string.
# - DIRECT_URL should use the direct connection string.
# Do not commit real Supabase credentials.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

JWT_SECRET="change-me-in-strict-runtimes"
# Required to call POST /auth/token in production, managed/Vercel, lockdown,
# missing, or unknown runtimes.
# Do not expose this value to browser clients.
AUTH_TOKEN_ISSUER_SECRET="change-me-for-server-side-token-minting"
# Minimum fluency events per execution before signals/pattern are disclosed (PRD Phase 3). Default 2.
# FLUENCY_MIN_EXECUTION_EVENTS_FOR_DISCLOSURE=2
# ALLOW_INSECURE_AUTH_FALLBACK is intentionally ignored in strict runtimes and
# cannot reopen fallback secrets.
# Local dev only: accept x-role / x-org-id headers instead of minted JWTs so the
# frontend and seed scripts can impersonate an org/role. `npm run dev` sets this
# automatically; uncomment if you start the backend another way (e.g. `npm start`).
# It is ignored in strict runtimes, including managed development/preview.
# DEV_HEADER_AUTH=true
